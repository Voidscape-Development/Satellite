#!/usr/bin/env sh
#
# Builds the OMT libraries Satellite ships: libomt and libvmx.
#
# Upstream publishes no binaries for either - both are source-only, and libomt is C# that
# has to be compiled to a native library with .NET NativeAOT. So Satellite builds them, and
# this script is what CI and developers both run. The .NET requirement is build-time only;
# nothing at run time needs a .NET installation.
#
# Output lands in <output>/ as the two shared libraries, ready for CMake to install beside
# the plugin binary.
#
# Usage: build-aux/build-omt [output-directory]
#
# Requirements:
#   .NET 8 SDK   (dotnet)   for libomt
#   clang++                 for libvmx
#   git

set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
root_dir=$(dirname "$script_dir")

output_dir=${1:-"$root_dir/deps/omt"}

# Deliberately outside the source tree. The macOS build runs
#   xattr -r -d com.apple.quarantine .deps
# with COMMAND_ERROR_IS_FATAL, and git pack files are read-only, so a clone anywhere under
# .deps fails that sweep with "Permission denied" and takes the whole configure down with it.
work_dir=${OMT_BUILD_DIR:-"${TMPDIR:-/tmp}/satellite-omt-build"}

# Pinned in buildspec.json so an update is a reviewable diff rather than whatever upstream
# happens to be that day. Keep these two in step.
spec="$root_dir/buildspec.json"
read_pin() {
    sed -n "/\"omt\"/,/^    }/p" "$spec" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -1
}

libomtnet_commit=$(read_pin libomtnetCommit)
libomt_commit=$(read_pin libomtCommit)
libvmx_commit=$(read_pin libvmxCommit)

if [ -z "$libomtnet_commit" ] || [ -z "$libomt_commit" ] || [ -z "$libvmx_commit" ]; then
    echo "error: could not read the OMT commit pins from $spec" >&2
    exit 1
fi

case $(uname -s) in
Darwin) platform=macos ;;
Linux) platform=linux ;;
*)
    echo "error: $(uname -s) is not handled here; Windows uses build-aux/Build-Omt.ps1" >&2
    exit 1
    ;;
esac

echo "==> building the OMT libraries for $platform into $output_dir"

mkdir -p "$work_dir" "$output_dir"

# libomt references libomtnet by a relative HintPath, so the two have to be siblings.
fetch() {
    name=$1
    commit=$2
    dir="$work_dir/$name"

    if [ ! -d "$dir/.git" ]; then
        echo "==> cloning $name"
        git clone --quiet "https://github.com/openmediatransport/$name" "$dir"
    fi

    git -C "$dir" fetch --quiet origin "$commit" 2>/dev/null || git -C "$dir" fetch --quiet origin
    git -C "$dir" checkout --quiet "$commit"
    echo "    $name at $(git -C "$dir" rev-parse --short HEAD)"
}

fetch libomtnet "$libomtnet_commit"
fetch libomt "$libomt_commit"
fetch libvmx "$libvmx_commit"

echo "==> building libvmx"
# -Wno-c++11-narrowing: libvmx initialises byte arrays from negative literals, which older
# clang only warned about and current clang rejects. Upstream's own script has no such flag
# and does not compile as-is with clang 18+.
vmx_common="-O3 -std=c++17 -fdeclspec -fPIC -Wno-c++11-narrowing"

if [ "$platform" = macos ]; then
    mkdir -p "$work_dir/vmx-arm64" "$work_dir/vmx-x86"
    # shellcheck disable=SC2086
    clang++ $vmx_common -target arm64-apple-darwin -mmacosx-version-min=10.15 -dynamiclib \
        "$work_dir/libvmx/src/vmxcodec_arm.cpp" "$work_dir/libvmx/src/vmxcodec.cpp" \
        -o "$work_dir/vmx-arm64/libvmx.dylib"
    install_name_tool -id @rpath/libvmx.dylib "$work_dir/vmx-arm64/libvmx.dylib"

    # shellcheck disable=SC2086
    clang++ $vmx_common -target x86_64-apple-darwin -mlzcnt -mavx2 -mbmi -mmacosx-version-min=10.15 -dynamiclib \
        "$work_dir/libvmx/src/vmxcodec_x86.cpp" "$work_dir/libvmx/src/vmxcodec_avx2.cpp" \
        "$work_dir/libvmx/src/vmxcodec.cpp" -o "$work_dir/vmx-x86/libvmx.dylib"
    install_name_tool -id @rpath/libvmx.dylib "$work_dir/vmx-x86/libvmx.dylib"

    lipo -create -output "$output_dir/libvmx.dylib" "$work_dir/vmx-x86/libvmx.dylib" \
        "$work_dir/vmx-arm64/libvmx.dylib"
    install_name_tool -id @rpath/libvmx.dylib "$output_dir/libvmx.dylib"
else
    # shellcheck disable=SC2086
    clang++ $vmx_common -mlzcnt -mavx2 -mbmi -shared -Wl,-rpath,'$ORIGIN' \
        "$work_dir/libvmx/src/vmxcodec_x86.cpp" "$work_dir/libvmx/src/vmxcodec_avx2.cpp" \
        "$work_dir/libvmx/src/vmxcodec.cpp" -o "$output_dir/libvmx.so"
fi

echo "==> building libomtnet"
dotnet build "$work_dir/libomtnet/libomtnet.sln" -c Release --nologo -v quiet

echo "==> building libomt (NativeAOT)"
if [ "$platform" = macos ]; then
    dotnet publish "$work_dir/libomt/libomt.sln" -r osx-arm64 -c Release --nologo -v quiet
    dotnet publish "$work_dir/libomt/libomt.sln" -r osx-x64 -c Release --nologo -v quiet

    arm_lib="$work_dir/libomt/bin/Release/net8.0/osx-arm64/native/libomt.dylib"
    x86_lib="$work_dir/libomt/bin/Release/net8.0/osx-x64/native/libomt.dylib"
    install_name_tool -id @rpath/libomt.dylib "$arm_lib"
    install_name_tool -id @rpath/libomt.dylib "$x86_lib"

    lipo -create -output "$output_dir/libomt.dylib" "$x86_lib" "$arm_lib"
    install_name_tool -id @rpath/libomt.dylib "$output_dir/libomt.dylib"
    # So libomt finds libvmx sitting next to it inside the plugin bundle.
    install_name_tool -add_rpath @loader_path "$output_dir/libomt.dylib" 2>/dev/null || true
else
    dotnet publish "$work_dir/libomt/libomt.sln" -r linux-x64 -c Release --nologo -v quiet
    cp "$work_dir/libomt/bin/Release/net8.0/linux-x64/native/libomt.so" "$output_dir/libomt.so"
fi

echo "==> done"
ls -l "$output_dir"
